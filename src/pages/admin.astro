---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { ui } from '@/lib/ui/design';
---

<Layout title="Administración - RaidDominion" description="Panel de administración de usuarios del portal RaidDominion.">
  <Navigation currentPath="/admin" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <!-- Cargando -->
      <div id="loading" class="text-center py-20">
        <div class={`${ui.loading.spinner} w-8 h-8`}></div>
        <p class={`${ui.loading.liveText} italic mt-4`}>Verificando permisos…</p>
      </div>

      <!-- Sin autorización -->
      <div id="denied" class={`hidden ${ui.panel} !border-red-900/40 rounded-md p-8 sm:p-10 text-center`}>
        <svg class="w-10 h-10 text-red-400/70 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <h2 class={`${ui.text.h2} text-white mb-2`}>Acceso restringido</h2>
        <p class={`${ui.text.bodyMuted} max-w-md mx-auto mb-6`}>Esta área es exclusiva para administradores.</p>
        <a href="/" class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105`}>Volver al inicio</a>
      </div>

      <!-- Panel -->
      <div id="panel" class="hidden space-y-8">
        <header class="animate-fade-in-1">
          <h1 class={`${ui.titleHero}`}>Administración</h1>
          <p class={`${ui.text.bodyMuted} italic mt-2`}>Gestión de usuarios y roles. El primer admin se siembra manualmente en la base de datos.</p>
        </header>
        <div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>

        <!-- Pestañas de sección (Usuarios · Discord) -->
        <div id="admin-tabs" role="tablist" aria-label="Secciones de administración" class="flex items-center gap-1 border-b border-gray-700/60 mb-6 animate-fade-in-1"></div>

        <!-- Vista: Discord (mercadeo automático) -->
        <div id="view-discord" class="hidden space-y-6">
          <section id="discord-panel" class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6 animate-fade-in-1" style="animation-delay: 0.1s">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <h2 class={`${ui.text.h2} text-amber-200 flex items-center`}>
                <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Discord · Mercadeo automático
              </h2>
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-500">objetivos reales → mensaje de conversión</span>
            </div>

            <p class="text-xs text-gray-400 mb-4">El asistente evalúa el estado de los objetivos y redacta un mensaje orientado a generar <span class="text-amber-300/80">usuarios y contenido para el addon</span>. Cada objetivo tiene sus dos botones: enviar al <span class="text-amber-300/80">canal de pruebas</span> (el de guild-portal que avisa cada ingreso) o al <span class="text-amber-300/80">canal público</span>.</p>

            <!-- Objetivos de conversión -->
            <h3 class={`${ui.subTitle}`}>Objetivos de conversión</h3>
            <div id="discord-goals" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-2 mb-5"></div>
            <p id="discord-status" class="hidden mt-3 text-sm rounded-md px-4 py-2.5" role="status" aria-live="polite"></p>
            <pre id="discord-preview" class="hidden mt-3 whitespace-pre-wrap rounded-md bg-gray-900/70 border border-amber-600/20 p-3 text-xs text-gray-300"></pre>
          </section>
        </div>

        <!-- Vista: listado de usuarios -->
        <div id="view-list" class="space-y-8">
          <!-- Métricas por rol -->
          <section id="role-stats" class="grid grid-cols-2 md:grid-cols-5 gap-4 animate-fade-in-1" style="animation-delay: 0.05s"></section>

          <!-- Búsqueda -->
          <div class="relative animate-fade-in-1" style="animation-delay: 0.1s">
            <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="search" id="search" placeholder="Buscar por correo, nombre o personaje…"
              class={`${ui.form.input} ${ui.focusRing} pl-9 pr-4`} />
          </div>

          <!-- Usuarios -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6 animate-fade-in-1" style="animation-delay: 0.15s">
            <p id="users-status" class={`${ui.loading.liveText} italic mb-3`} aria-live="polite">Cargando usuarios…</p>
            <ul id="users-list" class="space-y-3"></ul>
          </section>
        </div>

        <!-- Vista: detalle de usuario -->
        <div id="view-detail" class="hidden space-y-6">
          <button type="button" id="detail-back"
            class={`${ui.btnBase} ${ui.btnSecondary} px-4 py-2 text-xs font-black uppercase tracking-widest`}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Volver al listado
          </button>

          <!-- Perfil completo -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
              <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-amber-500 mb-1">Detalle de usuario</p>
                <h2 id="detail-name" class={`${ui.text.h1} text-amber-200`}></h2>
                <p id="detail-email" class={`${ui.text.bodyMuted} mt-1`}></p>
                <p id="detail-id" class="text-xs font-mono text-gray-500 mt-1 truncate"></p>
              </div>
              <span id="detail-role-badge" class={`${ui.badge} ${ui.badgeMd}`}></span>
            </div>

            <dl id="detail-fields" class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm"></dl>
          </section>

          <!-- Estado del perfil (editable por admin) -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class="text-lg font-bold text-amber-200 flex items-center mb-4">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 leading-[1.3] pb-[0.1em] font-black italic">Estado del perfil</span>
            </h2>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-gray-300">
                Visibilidad pública: <span id="detail-profile-vis-label" class="font-bold text-gray-100">—</span>
              </p>
              <div id="detail-profile-toggle"></div>
            </div>
            <div id="detail-profile-fields" class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3"></div>
            <p id="detail-profile-msg" class="hidden mt-3 text-sm rounded-md px-4 py-2.5" role="status"></p>
          </section>

          <!-- Gestión de rol (solo admin) -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class={`${ui.text.h2} text-amber-200 mb-4 flex items-center`}>
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Gestión de rol
            </h2>
            <div class="flex flex-wrap items-center gap-3">
              <select id="detail-role-select" class={`${ui.form.input} ${ui.focusRing} !w-auto`}></select>
              <button id="detail-role-save" type="button"
                class={`${ui.btnBase} ${ui.btnPrimary} px-5 py-2 text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:pointer-events-none`}>
                Guardar rol
              </button>
            </div>
            <p id="detail-role-msg" class="hidden mt-3 text-sm rounded-md px-4 py-2.5" role="status"></p>
          </section>

          <!-- Personajes del usuario -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class="text-lg font-bold text-amber-200 flex items-center mb-2">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 leading-[1.3] pb-[0.1em] font-black italic">Personajes</span>
            </h2>
            <p id="detail-chars-status" class="text-sm text-gray-400 italic mb-3" aria-live="polite">Cargando…</p>
            <ul id="detail-chars-list" class="space-y-2"></ul>
          </section>

          <!-- Hermandades del usuario -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class="text-lg font-bold text-amber-200 flex items-center mb-2">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 leading-[1.3] pb-[0.1em] font-black italic">Hermandades</span>
            </h2>
            <p id="detail-guilds-status" class="text-sm text-gray-400 italic mb-3" aria-live="polite">Cargando…</p>
            <ul id="detail-guilds-list" class="space-y-2"></ul>
          </section>

          <!-- Bandas del usuario -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class="text-lg font-bold text-amber-200 flex items-center mb-2">
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 leading-[1.3] pb-[0.1em] font-black italic">Bandas</span>
            </h2>
            <p id="detail-bands-status" class="text-sm text-gray-400 italic mb-3" aria-live="polite">Cargando…</p>
            <ul id="detail-bands-list" class="space-y-2"></ul>
          </section>

          <!-- Historial de auditoría del usuario -->
          <section class="bg-gray-900/60 backdrop-blur-sm border border-amber-600/25 rounded-md p-4 sm:p-6">
            <h2 class={`${ui.text.h2} text-amber-200 mb-4 flex items-center`}>
              <span class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"></span>Historial de auditoría
            </h2>
            <p id="detail-audit-status" class={`${ui.loading.liveText} italic`} aria-live="polite">Cargando…</p>
            <ul id="detail-audit-list" class="mt-3 space-y-2"></ul>
          </section>
        </div>
      </div>
      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<script>
  import {
    getMyProfile,
    adminListUsers,
    adminSetRole,
    listAuditLog,
    adminGetUserEntities,
    adminSetProfileField,
    adminSetCharacterStatus,
    adminSetGuildStatus,
    adminSetBandStatus,
    type AdminUserRow,
    type AuditRow,
    type AdminEntityCharacter,
    type AdminEntityGuild,
    type AdminEntityBand,
    type AdminUserEntities,
  } from '@/lib/api';
  import { ROLES } from '@/lib/roles';
  import { supabase } from '@/lib/supabase';
  import { ADMIN_PANELS, ADMIN_TABS, tabFromHash, resolveAdminHash } from '@/lib/ui/tabs';
  import { ui } from '@/lib/ui/design';
  import type { RaiddominionRole } from '@/types/database';

  const ROLE_LABELS: Record<RaiddominionRole, string> = {
    visitante: 'Visitante',
    member: 'Miembro',
    guild_master: 'Maestro',
    moderator: 'Moderador',
    admin: 'Admin',
  };
  const ROLE_BADGE = ui.badgeRole;
  const AUDIT_LABELS: Record<string, string> = {
    guild_claim_verified: 'Claim aprobado',
    guild_claim_rejected: 'Claim rechazado',
    guild_published: 'Portal republicado',
    guild_takedown: 'Portal retirado',
    user_role_changed: 'Rol cambiado',
    profile_field_changed: 'Perfil editado',
    character_status_changed: 'Personaje gestionado',
    guild_status_changed: 'Hermandad gestionada',
    band_status_changed: 'Banda gestionada',
  };

  let users: AdminUserRow[] = [];
  let audit: AuditRow[] = [];
  let activeRole: RaiddominionRole | null = null;
  const rpcAdmin = supabase.rpc.bind(supabase) as unknown as (fn: string, args?: Record<string, unknown>) => Promise<{ data: unknown; error: unknown }>;
  const searchEl = document.getElementById('search') as HTMLInputElement;
  searchEl.addEventListener('input', render);

  const res = await getMyProfile();
  const isPersonaAdmin = res.profile?.role === 'admin';
  const loading = document.getElementById('loading') as HTMLElement;
  loading.classList.add('hidden');

  if (!res.ok || !res.profile || res.profile.role !== 'admin') {
    if (res.ok && !res.profile) {
      window.location.replace('/login?next=%2Fadmin');
    } else {
      document.getElementById('denied')?.classList.remove('hidden');
    }
  } else {
    document.getElementById('panel')?.classList.remove('hidden');
    initAdminTabs();
    await loadUsers();
    // El historial de auditoría lo cargan todos los staff; el admin lo usa
    // además para el detalle de usuario.
    const aud = await listAuditLog();
    if (aud.ok) audit = aud.items ?? [];
    route();
  }

  // ── Barra de tabs de sección (Usuarios · Discord) ────────────────────────
  // Construye los botones desde ADMIN_TABS (contrato único). El contenido se
  // lo reparte route(): route() es quien muestra/oculta las vistas y marca el
  // tab activo; el click solo fija el hash.
  function initAdminTabs(): void {
    const bar = document.getElementById('admin-tabs') as HTMLElement;
    if (!bar) return;
    bar.innerHTML = '';
    ADMIN_TABS.forEach((t, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.id = `admin-tab-${t.id}`;
      btn.dataset.adminTab = t.id;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-controls', t.id === 'discord' ? 'view-discord' : 'view-list');
      btn.className = 'tab-btn shrink-0 whitespace-nowrap px-2 sm:px-4 py-2.5 text-xs font-black uppercase tracking-widest border-b-2 rounded-t-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';
      btn.textContent = t.label;
      btn.addEventListener('click', () => {
        window.history.replaceState(null, '', t.href);
        route();
      });
      if (i === 0) btn.tabIndex = 0; else btn.tabIndex = -1;
      bar.appendChild(btn);
    });
    bar.addEventListener('keydown', (e) => {
      const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-admin-tab]'));
      const idx = buttons.indexOf(e.target as HTMLButtonElement);
      if (idx === -1) return;
      const ev = e as KeyboardEvent;
      let next: number | null = null;
      if (ev.key === 'ArrowRight') next = (idx + 1) % buttons.length;
      else if (ev.key === 'ArrowLeft') next = (idx - 1 + buttons.length) % buttons.length;
      else if (ev.key === 'Home') next = 0;
      else if (ev.key === 'End') next = buttons.length - 1;
      if (next === null) return;
      ev.preventDefault();
      const target = buttons[next];
      target.focus();
      window.history.replaceState(null, '', ADMIN_TABS[next].href);
      route();
    });
  }

  function setTabActive(id: string): void {
    document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]').forEach((b) => {
      const active = b.dataset.adminTab === id;
      b.setAttribute('aria-selected', String(active));
      b.tabIndex = active ? 0 : -1;
      b.classList.toggle('border-amber-400', active);
      b.classList.toggle('text-amber-200', active);
      b.classList.toggle('border-transparent', !active);
      b.classList.toggle('text-gray-500', !active);
    });
  }

  // ── Routing por hash (#lista / #discord / #usuario/<id>) ────────────────
  function route(): void {
    const target = resolveAdminHash(window.location.hash);
    const listView = document.getElementById('view-list') as HTMLElement;
    const detailView = document.getElementById('view-detail') as HTMLElement;
    const discordView = document.getElementById('view-discord') as HTMLElement;
    if (target.kind === 'user') {
      const u = users.find((x) => x.id === target.id);
      listView.classList.add('hidden');
      discordView.classList.add('hidden');
      detailView.classList.remove('hidden');
      setTabActive(ADMIN_PANELS.LIST);
      if (u) renderDetail(u); else renderDetailMissing();
    } else {
      detailView.classList.add('hidden');
      const isDiscord = tabFromHash(window.location.hash) === ADMIN_TABS[1].id;
      listView.classList.toggle('hidden', isDiscord);
      discordView.classList.toggle('hidden', !isDiscord);
      setTabActive(isDiscord ? 'discord' : ADMIN_PANELS.LIST);
    }
  }
  window.addEventListener('hashchange', route);

  document.getElementById('detail-back')?.addEventListener('click', () => {
    window.history.replaceState(null, '', `#${ADMIN_PANELS.LIST}`);
    route();
  });

  // ── Discord: visibilidad del panel y carga de objetivos ─────────
  if (isPersonaAdmin) {
    await loadGoals();
  }

  function openDetail(id: string): void {
    window.history.replaceState(null, '', `#${ADMIN_PANELS.USER}/${id}`);
    route();
  }

  async function loadUsers(): Promise<void> {
    const statusEl = document.getElementById('users-status') as HTMLElement;
    const r = await adminListUsers();
    if (!r.ok) {
      statusEl.textContent = r.error || 'No se pudo cargar el listado.';
      return;
    }
    users = r.users ?? [];
    statusEl.textContent = `${users.length} usuario${users.length === 1 ? '' : 's'} registrado${users.length === 1 ? '' : 's'}.`;
    renderStats();
    render();
  }

  function renderStats(): void {
    const wrap = document.getElementById('role-stats') as HTMLElement;
    wrap.innerHTML = '';
    ROLES.forEach((role) => {
      const count = users.filter((u) => u.role === role).length;
      const isActive = activeRole === role;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `${ui.badge} ${ui.badgeMd} ${ROLE_BADGE[role]} p-4 text-left ${ui.focusRing} ${ui.transition} ${isActive ? ui.active : ''}`;
      btn.setAttribute('aria-pressed', String(isActive));
      const num = document.createElement('p');
      num.className = 'text-3xl font-black';
      num.textContent = String(count);
      const lbl = document.createElement('p');
      lbl.className = 'text-[10px] font-black uppercase tracking-widest opacity-80 mt-1';
      lbl.textContent = ROLE_LABELS[role];
      btn.append(num, lbl);
      btn.addEventListener('click', () => {
        activeRole = activeRole === role ? null : role;
        renderStats();
        render();
      });
      wrap.appendChild(btn);
    });
  }

  function render(): void {
    const listEl = document.getElementById('users-list') as HTMLElement;
    listEl.innerHTML = '';
    const q = searchEl.value.trim().toLowerCase();

    const filtered = users.filter((u) => {
      if (activeRole && u.role !== activeRole) return false;
      if (!q) return true;
      return (
        (u.email ?? '').toLowerCase().includes(q) ||
        (u.display_name ?? '').toLowerCase().includes(q) ||
        (u.character_name ?? '').toLowerCase().includes(q)
      );
    });

    filtered.forEach((u) => listEl.appendChild(userRow(u)));
  }

  function userRow(u: AdminUserRow): HTMLElement {
    const li = document.createElement('li');
    li.className = 'flex flex-wrap items-center justify-between gap-3 bg-gray-800/40 border border-amber-700/30 rounded-md px-4 py-3';

    const info = document.createElement('div');
    info.className = 'min-w-0';
    const email = document.createElement('p');
    email.className = 'text-sm font-bold text-white truncate';
    email.textContent = u.email ?? u.id;
    const meta = document.createElement('p');
    meta.className = 'text-xs text-gray-500 mt-0.5 truncate';
    const parts = [
      [u.display_name, u.character_name].filter(Boolean).join(' · ') || 'sin nombre',
      u.realm,
      `desde ${new Date(u.created_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}`,
    ].filter(Boolean);
    meta.textContent = parts.join(' · ');
    info.append(email, meta);
    li.appendChild(info);

    const right = document.createElement('div');
    right.className = 'flex items-center gap-2 shrink-0';

    const badge = document.createElement('span');
    badge.className = `${ui.badge} ${ui.badgeMd} ${ROLE_BADGE[u.role]}`;
    badge.textContent = ROLE_LABELS[u.role];
    right.appendChild(badge);

    const detailBtn = document.createElement('button');
    detailBtn.type = 'button';
    detailBtn.className = `${ui.btnBase} ${ui.btnSecondary} px-4 py-2 text-[11px] font-black uppercase tracking-widest`;
    detailBtn.textContent = 'Detalle';
    detailBtn.addEventListener('click', () => openDetail(u.id));
    right.appendChild(detailBtn);

    li.append(info, right);
    return li;
  }

  // ── Detalle de usuario ───────────────────────────────────────────────
  function renderDetailMissing(): void {
    (document.getElementById('detail-name') as HTMLElement).textContent = 'Usuario no encontrado';
    (document.getElementById('detail-email') as HTMLElement).textContent = '';
    (document.getElementById('detail-id') as HTMLElement).textContent = '';
    (document.getElementById('detail-fields') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-role-select') as HTMLSelectElement).innerHTML = '';
    (document.getElementById('detail-audit-list') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-audit-status') as HTMLElement).textContent = 'Sin historial.';
    (document.getElementById('detail-chars-list') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-chars-status') as HTMLElement).textContent = 'Sin personajes.';
    (document.getElementById('detail-guilds-list') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-guilds-status') as HTMLElement).textContent = 'Sin hermandades.';
    (document.getElementById('detail-bands-list') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-bands-status') as HTMLElement).textContent = 'Sin bandas.';
    (document.getElementById('detail-profile-toggle') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-profile-fields') as HTMLElement).innerHTML = '';
    (document.getElementById('detail-profile-vis-label') as HTMLElement).textContent = '—';
    (document.getElementById('detail-profile-msg') as HTMLElement).classList.add('hidden');
  }

  function renderDetail(u: AdminUserRow): void {
    (document.getElementById('detail-name') as HTMLElement).textContent = u.display_name || u.character_name || u.email || 'Sin nombre';
    (document.getElementById('detail-email') as HTMLElement).textContent = u.email ?? u.id;
    (document.getElementById('detail-id') as HTMLElement).textContent = u.id;

    const badge = document.getElementById('detail-role-badge') as HTMLElement;
    badge.textContent = ROLE_LABELS[u.role];
    badge.className = `${ui.badge} ${ui.badgeMd} ${ROLE_BADGE[u.role]}`;

    // Perfil completo (los datos provienen de adminListUsers).
    const fields = document.getElementById('detail-fields') as HTMLElement;
    fields.innerHTML = '';
    const rows: Array<{ k: string; v: string; mono?: boolean }> = [
      { k: 'ID (hex)', v: u.id, mono: true },
      { k: 'Correo', v: u.email ?? '—' },
      { k: 'Nombre visible', v: u.display_name ?? '—' },
      { k: 'Personaje principal', v: u.character_name ?? '—' },
      { k: 'Reino', v: u.realm ?? '—' },
      { k: 'Slug público', v: u.slug ?? '—' },
      { k: 'Estado del perfil', v: u.is_public ? 'Público' : 'Privado' },
      { k: 'Registro', v: new Date(u.created_at).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' }) },
    ];
    rows.forEach(({ k, v, mono }) => {
      const dt = document.createElement('dt');
      dt.className = 'text-[10px] font-black uppercase tracking-widest text-gray-500';
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.className = mono ? 'text-sm font-mono text-amber-200/90 truncate' : 'text-sm text-gray-200';
      if (mono) {
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'inline-flex items-center gap-1.5 ml-2 px-1.5 py-0.5 text-[10px] font-black uppercase tracking-widest rounded border border-amber-600/30 text-amber-300/80 hover:bg-amber-900/30 hover:border-amber-500/50 transition-colors';
        copy.textContent = 'copiar';
        copy.addEventListener('click', async () => {
          await navigator.clipboard.writeText(v).catch(() => undefined);
          copy.textContent = '✓ copiado';
          window.setTimeout(() => { copy.textContent = 'copiar'; }, 2000);
        });
        dd.textContent = v;
        dd.appendChild(copy);
      } else {
        dd.textContent = v;
      }
      fields.append(dt, dd);
    });
    // Enlace al perfil público si está publicado
    if (u.is_public && u.slug) {
      const link = document.createElement('a');
      link.href = `/jugador/${u.slug}`;
      link.target = '_blank'; link.rel = 'noopener';
      link.className = 'text-sm text-emerald-300 underline hover:text-emerald-200';
      link.textContent = 'Ver perfil público →';
      fields.appendChild(link);
    }

    // Selector de rol (solo admin puede cambiar roles)
    const sel = document.getElementById('detail-role-select') as HTMLSelectElement;
    sel.innerHTML = '';
    ROLES.forEach((r) => {
      const opt = document.createElement('option');
      opt.value = r;
      opt.textContent = ROLE_LABELS[r];
      opt.selected = r === u.role;
      sel.appendChild(opt);
    });
    const saveBtn = document.getElementById('detail-role-save') as HTMLButtonElement;
    saveBtn.disabled = false;
    saveBtn.textContent = 'Guardar rol';
    (document.getElementById('detail-role-msg') as HTMLElement).classList.add('hidden');

    renderAudit(u.id);
    loadEntities(u.id);
  }

  // ── Entidades del usuario (personajes · hermandades · bandas) ────────
  async function loadEntities(userId: string): Promise<void> {
    const charsStatus = document.getElementById('detail-chars-status') as HTMLElement;
    const guildsStatus = document.getElementById('detail-guilds-status') as HTMLElement;
    const bandsStatus = document.getElementById('detail-bands-status') as HTMLElement;

    const r = await adminGetUserEntities(userId);
    if (!r.ok || !r.entities) {
      charsStatus.textContent = r.error || 'No se pudo cargar los datos.';
      guildsStatus.textContent = '';
      bandsStatus.textContent = '';
      return;
    }

    const { characters, guilds, bands, profile } = r.entities;

    renderProfile(userId, profile);
    renderCharacters(characters);
    renderGuilds(guilds);
    renderBands(bands);

    const listChars = characters.length;
    const listGuilds = guilds.length;
    const listBands = bands.length;
    charsStatus.textContent = listChars === 0 ? 'Sin personajes registrados.' : '';
    guildsStatus.textContent = listGuilds === 0 ? 'Sin hermandades.' : '';
    bandsStatus.textContent = listBands === 0 ? 'Sin bandas.' : '';
  }

  // ── Estado del perfil (visibilidad + campos editables) ───────────────
  function renderProfile(userId: string, p: NonNullable<AdminUserEntities['profile']>): void {
    const visLabel = document.getElementById('detail-profile-vis-label') as HTMLElement;
    visLabel.textContent = p.is_public ? 'público' : 'privado';
    visLabel.className = p.is_public ? 'font-bold text-emerald-300' : 'font-bold text-gray-400';

    const toggleWrap = document.getElementById('detail-profile-toggle') as HTMLElement;
    toggleWrap.innerHTML = '';
    toggleWrap.appendChild(makeAdminSwitch(p.is_public, 'Público', (input, status) =>
      runToggle(input, status, () => adminSetProfileField(userId, 'is_public', String(input.checked)), () => {
        p.is_public = input.checked;
        visLabel.textContent = p.is_public ? 'público' : 'privado';
        visLabel.className = p.is_public ? 'font-bold text-emerald-300' : 'font-bold text-gray-400';
      }),
    ));

    const fieldsWrap = document.getElementById('detail-profile-fields') as HTMLElement;
    fieldsWrap.innerHTML = '';
    const defs: Array<{ key: 'display_name' | 'character_name' | 'realm'; label: string; value: string | null }> = [
      { key: 'display_name', label: 'Nombre visible', value: p.display_name },
      { key: 'character_name', label: 'Personaje principal', value: p.character_name },
      { key: 'realm', label: 'Reino', value: p.realm },
    ];
    defs.forEach((d) => {
      const box = document.createElement('div');
      const lbl = document.createElement('label');
      lbl.className = `${ui.form.label} block`;
      lbl.textContent = d.label;
      lbl.htmlFor = `pf-${d.key}`;
      const input = document.createElement('input');
      input.id = `pf-${d.key}`;
      input.type = 'text';
      input.value = d.value ?? '';
      input.placeholder = '—';
      input.className = `${ui.form.input} ${ui.focusRing}`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `${ui.btnBase} ${ui.btnSecondary} w-full mt-2 px-3 py-1.5 text-[11px] font-black uppercase tracking-widest`;
      btn.textContent = 'Guardar';
      const status = document.createElement('span');
      status.className = 'text-[10px] font-bold uppercase tracking-widest mt-1 block text-center';
      status.setAttribute('aria-live', 'polite');
      input.addEventListener('input', () => {
        const changed = (input.value.trim() || null) !== (d.value ?? null);
        btn.disabled = !changed;
      });
      btn.disabled = (input.value.trim() || null) === (d.value ?? null);
      btn.addEventListener('click', async () => {
        const newVal = input.value.trim();
        btn.disabled = true;
        status.textContent = 'guardando…';
        status.className = 'text-[10px] font-bold uppercase tracking-widest mt-1 block text-center text-amber-300';
        const r = await adminSetProfileField(userId, d.key, newVal);
        if (r.ok) {
          d.value = newVal || null;
          input.value = newVal;
          status.textContent = '✓ guardado';
          status.className = 'text-[10px] font-bold uppercase tracking-widest mt-1 block text-center text-emerald-400';
        } else {
          status.textContent = '✗ error';
          status.className = 'text-[10px] font-bold uppercase tracking-widest mt-1 block text-center text-red-400';
          btn.disabled = false;
        }
        window.setTimeout(() => { status.textContent = ''; }, 2500);
      });
      box.append(lbl, input, btn, status);
      fieldsWrap.appendChild(box);
    });
  }

  // Toggle pill ON/OFF del dashboard (makeSwitch) vía token del design.
  function makeAdminSwitch(
    checked: boolean,
    text: string,
    onChange: (input: HTMLInputElement, status: HTMLElement) => Promise<void>,
  ): HTMLElement {
    const label = document.createElement('label');
    label.className = `${ui.toggleLabel} shrink-0`;
    const input = document.createElement('input');
    input.type = 'checkbox';
    input.className = 'peer sr-only';
    input.checked = checked;
    const track = document.createElement('span');
    track.className = ui.toggleTrack;
    const textEl = document.createElement('span');
    textEl.textContent = text;
    const status = document.createElement('span');
    status.className = 'text-[10px] font-bold uppercase tracking-widest';
    status.setAttribute('aria-live', 'polite');
    label.append(input, track, textEl, status);
    input.addEventListener('change', () => onChange(input, status));
    return label;
  }

  async function runToggle(
    input: HTMLInputElement,
    status: HTMLElement,
    fn: () => Promise<{ ok: boolean; error?: string }>,
    onSuccess: () => void,
  ): Promise<void> {
    input.disabled = true;
    status.textContent = 'guardando…';
    status.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
    const r = await fn();
    input.disabled = false;
    if (r.ok) {
      onSuccess();
      status.textContent = '✓ hecho';
      status.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
    } else {
      input.checked = !input.checked;
      status.textContent = '✗ error';
      status.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
    }
    window.setTimeout(() => { status.textContent = ''; }, 2500);
  }

  // ── Personajes ────────────────────────────────────────────────────────
  function renderCharacters(chars: AdminEntityCharacter[]): void {
    const listEl = document.getElementById('detail-chars-list') as HTMLElement;
    listEl.innerHTML = '';
    chars.forEach((c) => {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-3 bg-gray-800/40 border border-amber-700/30 rounded-md px-4 py-3';

      const info = document.createElement('div');
      info.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'text-sm font-bold text-white truncate';
      name.textContent = `${c.name}${c.sv_is_gm ? ' ★' : ''}`;
      const meta = document.createElement('p');
      meta.className = 'text-xs text-gray-500 mt-0.5 flex flex-wrap items-center gap-1.5';
      const parts: Array<string | null> = [c.realm, c.server, c.class, c.level != null ? `Nv ${c.level}` : null, c.avg_ilvl != null ? `ilvl ${c.avg_ilvl}` : null, c.sv_guild_name];
      parts.forEach((p, i) => {
        if (!p) return;
        if (i > 0) {
          const sep = document.createElement('span');
          sep.textContent = '·';
          sep.className = 'text-gray-600';
          meta.appendChild(sep);
        }
        const span = document.createElement('span');
        span.textContent = p;
        meta.appendChild(span);
      });
      info.append(name, meta);
      li.appendChild(info);

      const right = document.createElement('div');
      right.className = 'flex flex-wrap items-center gap-3 shrink-0';

      const pubStatus = c.is_public ? 'pública' : 'privada';
      const pubBadge = document.createElement('span');
      pubBadge.className = `${ui.badge} ${ui.badgeMd} ${c.is_public ? 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40' : 'text-gray-400 bg-gray-950/50 border-gray-700/50'}`;
      pubBadge.textContent = pubStatus;

      const verStatus = c.member_verified ? 'verificado' : 'sin verificar';
      const verBadge = document.createElement('span');
      verBadge.className = `${ui.badge} ${ui.badgeMd} ${c.member_verified ? 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40' : 'text-amber-300 bg-amber-950/30 border-amber-500/40'}`;
      verBadge.textContent = verStatus;

      right.append(pubBadge, verBadge);

      right.appendChild(makeAdminSwitch(c.is_public, 'Público', (input, status) =>
        runToggle(input, status, () => adminSetCharacterStatus(c.id, input.checked, c.member_verified), () => {
          c.is_public = input.checked;
          pubBadge.textContent = c.is_public ? 'pública' : 'privada';
          pubBadge.className = `${ui.badge} ${ui.badgeMd} ${c.is_public ? 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40' : 'text-gray-400 bg-gray-950/50 border-gray-700/50'}`;
        }),
      ));

      right.appendChild(makeAdminSwitch(c.member_verified, 'Verificado', (input, status) =>
        runToggle(input, status, () => adminSetCharacterStatus(c.id, c.is_public, input.checked), () => {
          c.member_verified = input.checked;
          verBadge.textContent = c.member_verified ? 'verificado' : 'sin verificar';
          verBadge.className = `${ui.badge} ${ui.badgeMd} ${c.member_verified ? 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40' : 'text-amber-300 bg-amber-950/30 border-amber-500/40'}`;
        }),
      ));

      li.append(info, right);
      listEl.appendChild(li);
    });
  }

  // ── Hermandades ───────────────────────────────────────────────────────
  function renderGuilds(guilds: AdminEntityGuild[]): void {
    const listEl = document.getElementById('detail-guilds-list') as HTMLElement;
    listEl.innerHTML = '';
    guilds.forEach((g) => {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-3 bg-gray-800/40 border border-amber-700/30 rounded-md px-4 py-3';

      const info = document.createElement('div');
      info.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'text-sm font-bold text-white truncate';
      name.textContent = g.name;
      const meta = document.createElement('p');
      meta.className = 'text-xs text-gray-500 mt-0.5 truncate';
      meta.textContent = [g.realm, g.server, g.faction].filter(Boolean).join(' · ') || 'sin datos';
      info.append(name, meta);
      li.appendChild(info);

      const right = document.createElement('div');
      right.className = 'flex flex-wrap items-center gap-3 shrink-0';

      const claimBadge = document.createElement('span');
      claimBadge.className = `${ui.badge} ${ui.badgeMd} ${claimColor(g.claim_status)}`;
      claimBadge.textContent = claimLabel(g.claim_status);

      right.appendChild(claimBadge);
      right.appendChild(makeAdminSwitch(g.is_public, 'Público', (input, status) =>
        runToggle(input, status, () => adminSetGuildStatus(g.id, input.checked, g.claim_status), () => {
          g.is_public = input.checked;
        }),
      ));

      // Selector de estado de claim con doble confirmación en el propio botón
      const right2 = document.createElement('div');
      right2.className = 'flex flex-wrap items-center gap-2';

      const claimSel = document.createElement('select');
      claimSel.className = `${ui.form.input} ${ui.focusRing} !w-auto text-xs`;
      ['pending', 'verified', 'rejected'].forEach((v) => {
        const opt = document.createElement('option');
        opt.value = v;
        opt.textContent = claimLabel(v as AdminEntityGuild['claim_status']);
        opt.selected = v === g.claim_status;
        claimSel.appendChild(opt);
      });

      const saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.className = `${ui.btnBase} ${ui.btnSecondary} px-3 py-1.5 text-[11px] font-black uppercase tracking-widest`;
      saveBtn.textContent = 'Guardar estado';
      const msg = document.createElement('span');
      msg.className = 'text-[10px] font-bold uppercase tracking-widest';
      msg.setAttribute('aria-live', 'polite');

      saveBtn.addEventListener('click', async () => {
        const newStatus = claimSel.value as AdminEntityGuild['claim_status'];
        if (newStatus === g.claim_status) {
          msg.textContent = 'sin cambios';
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-gray-500';
          return;
        }
        if (saveBtn.dataset.confirm !== 'yes') {
          saveBtn.dataset.confirm = 'yes';
          saveBtn.textContent = '¿Confirmar?';
          msg.textContent = `Se marcará «${claimLabel(newStatus)}».`;
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
          window.setTimeout(() => {
            if (saveBtn.dataset.confirm === 'yes') {
              saveBtn.dataset.confirm = '';
              saveBtn.textContent = 'Guardar estado';
              msg.textContent = '';
            }
          }, 4000);
          return;
        }
        saveBtn.disabled = true;
        saveBtn.dataset.confirm = '';
        const r = await adminSetGuildStatus(g.id, g.is_public, newStatus);
        saveBtn.disabled = false;
        if (r.ok) {
          g.claim_status = newStatus;
          saveBtn.textContent = 'Guardar estado';
          claimBadge.textContent = claimLabel(newStatus);
          claimBadge.className = `${ui.badge} ${ui.badgeMd} ${claimColor(newStatus)}`;
          msg.textContent = '✓ guardado';
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
        } else {
          msg.textContent = '✗ ' + (r.error || 'error');
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
          saveBtn.textContent = 'Guardar estado';
        }
        window.setTimeout(() => { msg.textContent = ''; }, 2500);
      });

      right2.append(claimSel, saveBtn, msg);
      li.append(info, right, right2);
      listEl.appendChild(li);
    });
  }

  function claimLabel(s: AdminEntityGuild['claim_status']): string {
    if (s === 'verified') return '✓ verificada';
    if (s === 'rejected') return '✗ rechazada';
    return '⏳ pendiente';
  }
  function claimColor(s: AdminEntityGuild['claim_status']): string {
    if (s === 'verified') return 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40';
    if (s === 'rejected') return 'text-red-300 bg-red-950/30 border-red-600/40';
    return 'text-amber-300 bg-amber-950/30 border-amber-500/40';
  }

  // ── Bandas ────────────────────────────────────────────────────────────
  function renderBands(bands: AdminEntityBand[]): void {
    const listEl = document.getElementById('detail-bands-list') as HTMLElement;
    listEl.innerHTML = '';
    bands.forEach((b) => {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-3 bg-gray-800/40 border border-amber-700/30 rounded-md px-4 py-3';

      const info = document.createElement('div');
      info.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'text-sm font-bold text-white truncate';
      name.textContent = b.name;
      const meta = document.createElement('p');
      meta.className = 'text-xs text-gray-500 mt-0.5 truncate';
      const sub = [b.icon, b.schedule, b.character_name ? `por ${b.character_name}` : null].filter(Boolean).join(' · ');
      meta.textContent = sub || (b.integration_status !== 'none' ? 'integrada' : 'sin integración');
      info.append(name, meta);
      li.appendChild(info);

      const right = document.createElement('div');
      right.className = 'flex flex-wrap items-center gap-3 shrink-0';

      const integrationBadge = document.createElement('span');
      integrationBadge.className = `${ui.badge} ${ui.badgeMd} ${integrationColor(b.integration_status)}`;
      integrationBadge.textContent = integrationLabel(b, true);
      right.appendChild(integrationBadge);

      right.appendChild(makeAdminSwitch(b.is_public, 'Público', (input, status) =>
        runToggle(input, status, () => adminSetBandStatus(b.id, input.checked, b.integration_status), () => {
          b.is_public = input.checked;
        }),
      ));

      const integSel = document.createElement('select');
      integSel.className = `${ui.form.input} ${ui.focusRing} !w-auto text-xs`;
      ['none', 'pending', 'approved', 'rejected'].forEach((v) => {
        const opt = document.createElement('option');
        opt.value = v;
        opt.textContent = integrationLabel({ ...b, integration_status: v as AdminEntityBand['integration_status'] }, false);
        opt.selected = v === b.integration_status;
        integSel.appendChild(opt);
      });

      const saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.className = `${ui.btnBase} ${ui.btnSecondary} px-3 py-1.5 text-[11px] font-black uppercase tracking-widest`;
      saveBtn.textContent = 'Guardar integración';
      const msg = document.createElement('span');
      msg.className = 'text-[10px] font-bold uppercase tracking-widest';
      msg.setAttribute('aria-live', 'polite');

      saveBtn.addEventListener('click', async () => {
        const newStatus = integSel.value as AdminEntityBand['integration_status'];
        if (newStatus === b.integration_status) {
          msg.textContent = 'sin cambios';
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-gray-500';
          return;
        }
        if (saveBtn.dataset.confirm !== 'yes') {
          saveBtn.dataset.confirm = 'yes';
          saveBtn.textContent = '¿Confirmar?';
          msg.textContent = `Se marcará «${integrationLabel({ ...b, integration_status: newStatus }, false)}».`;
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-amber-300';
          window.setTimeout(() => {
            if (saveBtn.dataset.confirm === 'yes') {
              saveBtn.dataset.confirm = '';
              saveBtn.textContent = 'Guardar integración';
              msg.textContent = '';
            }
          }, 4000);
          return;
        }
        saveBtn.disabled = true;
        saveBtn.dataset.confirm = '';
        const r = await adminSetBandStatus(b.id, b.is_public, newStatus);
        saveBtn.disabled = false;
        if (r.ok) {
          b.integration_status = newStatus;
          saveBtn.textContent = 'Guardar integración';
          integrationBadge.textContent = integrationLabel(b, true);
          integrationBadge.className = `${ui.badge} ${ui.badgeMd} ${integrationColor(newStatus)}`;
          msg.textContent = '✓ guardado';
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-emerald-400';
        } else {
          msg.textContent = '✗ ' + (r.error || 'error');
          msg.className = 'text-[10px] font-bold uppercase tracking-widest text-red-400';
          saveBtn.textContent = 'Guardar integración';
        }
        window.setTimeout(() => { msg.textContent = ''; }, 2500);
      });

      right.append(integSel, saveBtn, msg);
      li.append(info, right);
      listEl.appendChild(li);
    });
  }

  function integrationLabel(b: AdminEntityBand, full: boolean): string {
    if (b.integration_status === 'approved') return full ? '✓ integrada' : 'integrada';
    if (b.integration_status === 'pending') return full ? '⏳ pendiente' : 'propuesta';
    if (b.integration_status === 'rejected') return full ? '✗ rechazada' : 'rechazada';
    return full ? 'sin integración' : 'sin integración';
  }
  function integrationColor(s: AdminEntityBand['integration_status']): string {
    if (s === 'approved') return 'text-emerald-300 bg-emerald-950/30 border-emerald-600/40';
    if (s === 'rejected') return 'text-red-300 bg-red-950/30 border-red-600/40';
    if (s === 'pending') return 'text-amber-300 bg-amber-950/30 border-amber-500/40';
    return 'text-gray-400 bg-gray-950/50 border-gray-700/50';
  }

  // Confirmación explícita antes de cambiar el rol
  document.getElementById('detail-role-save')?.addEventListener('click', async () => {
    const sel = document.getElementById('detail-role-select') as HTMLSelectElement;
    const saveBtn = document.getElementById('detail-role-save') as HTMLButtonElement;
    const msg = document.getElementById('detail-role-msg') as HTMLElement;
    msg.classList.remove('hidden');

    const target = resolveAdminHash(window.location.hash);
    if (target.kind !== 'user') return;
    const u = users.find((x) => x.id === target.id);
    if (!u) return;

    const newRole = sel.value as RaiddominionRole;
    if (newRole === u.role) {
      msg.className = 'mt-3 text-sm rounded-md px-4 py-2.5 bg-gray-800/60 border border-gray-600/40 text-gray-300';
      msg.textContent = 'El rol seleccionado ya es el actual; no hay cambios.';
      return;
    }

    // Paso de confirmación: el botón pide confirmar antes de persistir.
    if (saveBtn.dataset.confirm !== 'yes') {
      saveBtn.dataset.confirm = 'yes';
      saveBtn.textContent = '¿Confirmar cambio?';
      msg.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.status.warning}`;
      msg.textContent = `Se cambiará el rol de ${u.email ?? u.id} a «${ROLE_LABELS[newRole]}».`;
      window.setTimeout(() => {
        if (saveBtn.dataset.confirm === 'yes') {
          saveBtn.dataset.confirm = '';
          saveBtn.textContent = 'Guardar rol';
          msg.classList.add('hidden');
        }
      }, 4000);
      return;
    }

    saveBtn.disabled = true;
    saveBtn.dataset.confirm = '';
    saveBtn.textContent = 'Guardando…';
    const r = await adminSetRole(u.id, newRole);
    saveBtn.disabled = false;
    if (r.ok) {
      u.role = newRole;
      msg.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.status.success}`;
      msg.textContent = 'Rol actualizado.';
      saveBtn.textContent = 'Guardar rol';
      renderStats();
      render();
      // refresca el badge del detalle
      const badge = document.getElementById('detail-role-badge') as HTMLElement;
      badge.textContent = ROLE_LABELS[newRole];
      badge.className = `${ui.badge} ${ui.badgeMd} ${ROLE_BADGE[newRole]}`;
    } else {
      msg.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.status.error}`;
      msg.textContent = r.error || 'No se pudo cambiar el rol.';
      saveBtn.textContent = 'Guardar rol';
    }
  });

  // Historial de auditoría filtrado al usuario (actor o target coincide)
  function renderAudit(userId: string): void {
    const status = document.getElementById('detail-audit-status') as HTMLElement;
    const listEl = document.getElementById('detail-audit-list') as HTMLElement;
    listEl.innerHTML = '';

    const mine = audit.filter((a) => a.actor_id === userId || (a.target ?? '').includes(userId));
    if (mine.length === 0) {
      status.textContent = 'Sin acciones registradas para este usuario.';
      return;
    }
    status.classList.add('hidden');
    mine.forEach((a) => {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-2 text-xs text-gray-400 border-b border-amber-600/10 pb-2';
      const action = document.createElement('span');
      action.className = 'font-bold text-amber-200';
      action.textContent = AUDIT_LABELS[a.action] ?? a.action;
      const when = new Date(a.created_at).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' });
      const meta = document.createElement('span');
      meta.textContent = `${a.actor_id === userId ? 'actor' : 'objetivo'} · ${when}`;
      li.append(action, meta);
      listEl.appendChild(li);
    });
  }

  // ── Discord: mercadeo automático (objetivos → mensaje) ─────────────────
  interface MarketingGoalView {
    goal_key: string;
    label: string;
    target: number;
    trend: 'up' | 'hold' | 'down';
    current_value: number;
    focus_boost: boolean;
  }

  // Trae el estado de los objetivos desde el RPC de evaluación (persiste y
  // devuelve la lista). Doc: el RPC hace la evaluación real del motor.
  async function fetchGoals(): Promise<MarketingGoalView[]> {
    // El snapshot viene en array de una fila (RETURNS TABLE); se normaliza a
    // objeto para que la evaluación acepte p_stats (jsonb_typeof = object).
    const stats = await rpcAdmin('raiddominion_marketing_stats');
    const statsRow = Array.isArray(stats.data) ? (stats.data[0] ?? {}) : (stats.data ?? {});
    const goals = await rpcAdmin('raiddominion_marketing_evaluate', { p_stats: statsRow });
    return (Array.isArray(goals.data) ? goals.data : []) as unknown as MarketingGoalView[];
  }

  function goalBadgeClasses(trend: MarketingGoalView['trend']): string {
    if (trend === 'down') return `${ui.badge} ${ui.badgeRole.visitante}`;
    if (trend === 'up') return `${ui.badge} ${ui.badgeRole.member}`;
    return `${ui.badge} ${ui.badgeRole.guild_master}`;
  }

  function renderGoals(goals: MarketingGoalView[]): void {
    const wrap = document.getElementById('discord-goals') as HTMLElement;
    wrap.innerHTML = '';
    goals.forEach((g) => {
      const card = document.createElement('div');
      card.className = `rounded-md p-3 border ${g.focus_boost ? 'border-amber-500/60 bg-amber-950/20' : 'border-gray-700/40 bg-gray-800/40'}`;
      const top = document.createElement('div');
      top.className = 'flex items-center justify-between gap-2';
      const label = document.createElement('p');
      label.className = 'text-[10px] font-black uppercase tracking-widest text-gray-400';
      label.textContent = g.label;
      const badge = document.createElement('span');
      badge.className = goalBadgeClasses(g.trend);
      badge.textContent = g.trend === 'up' ? 'alza' : g.trend === 'down' ? 'baja' : 'estable';
      top.append(label, badge);
      const val = document.createElement('p');
      val.className = 'text-xl font-black text-amber-200 mt-1';
      val.textContent = String(g.current_value);
      const tgt = document.createElement('p');
      tgt.className = 'text-[10px] text-gray-500';
      tgt.textContent = `objetivo ${g.target}${g.focus_boost ? ' · priorizar' : ''}`;
      card.append(top, val, tgt);

      const actions = document.createElement('div');
      actions.className = 'flex items-center gap-1.5 mt-2.5 pt-2 border-t border-gray-700/40';
      const btnCls = `${ui.btnBase} ${ui.btnSecondary} flex-1 px-2 py-1 text-[10px] font-black uppercase tracking-widest`;
      const testBtn = document.createElement('button');
      testBtn.type = 'button';
      testBtn.className = btnCls;
      testBtn.textContent = 'Pruebas';
      testBtn.setAttribute('aria-label', `Enviar ${g.label} al canal de pruebas`);
      testBtn.addEventListener('click', () => sendDiscordMessage(g.goal_key, 'test', g.label));
      const pubBtn = document.createElement('button');
      pubBtn.type = 'button';
      pubBtn.className = btnCls;
      pubBtn.textContent = 'Público';
      pubBtn.setAttribute('aria-label', `Enviar ${g.label} al canal público`);
      pubBtn.addEventListener('click', () => sendDiscordMessage(g.goal_key, 'prod', g.label));
      actions.append(testBtn, pubBtn);
      card.appendChild(actions);
      wrap.appendChild(card);
    });
  }

  async function loadGoals(): Promise<void> {
    try {
      const goals = await fetchGoals();
      if (goals.length > 0) renderGoals(goals);
    } catch (err) {
      console.error('[discord-goals]', err);
    }
  }

  // ── Envío de un objetivo a Discord (pruebas o público) ────────────────
  async function sendDiscordMessage(goalKey: string, canal: 'test' | 'prod', label: string): Promise<void> {
    const status = document.getElementById('discord-status') as HTMLElement;
    const preview = document.getElementById('discord-preview') as HTMLElement;
    status.classList.remove('hidden');
    preview.classList.add('hidden');

    status.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.loading.liveText}`;
    status.textContent = `Generando y enviando «${label}»…`;

    try {
      const r = await fetch('/api/discord-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ goal_key: goalKey, canal }),
      });
      const data = (await r.json().catch(() => null)) as {
        ok?: boolean;
        sent?: boolean;
        message?: string;
        goals?: number;
        error?: string;
      } | null;

      if (data?.ok) {
        status.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${data.sent ? ui.status.success : ui.status.warning}`;
        status.textContent = data.sent
          ? `Objetivo «${label}» enviado al canal ${canal === 'test' ? 'de pruebas' : 'público'}.`
          : 'No se envió (webhook no configurado para ese canal).';
        if (data.message) {
          preview.textContent = data.message;
          preview.classList.remove('hidden');
        }
        await loadGoals();
      } else {
        status.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.status.error}`;
        status.textContent = data?.error || 'No se pudo generar el mensaje.';
      }
    } catch {
      status.className = `mt-3 text-sm rounded-md px-4 py-2.5 ${ui.status.error}`;
      status.textContent = 'Error de red al contactar el motor de mercadeo.';
    }
  }
</script>
