---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { ui } from '@/lib/ui/design';
---

<Layout title="Sube tu SavedVariables - RaidDominion" description="Sube tu RaidDominion.lua y visualiza el roster y las bandas de tu hermandad.">
  <Navigation currentPath="/upload" />
  <main class="relative py-16">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb />
      <!-- Header -->
      <header class="text-center mb-12 animate-fade-in-1">
        <div class="w-12 h-12 mx-auto mb-4 bg-gradient-to-br from-amber-600 to-amber-800 rounded-md flex items-center justify-center shadow-lg shadow-amber-900/20">
          <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <h1 class={`${ui.titleHero}`}>
          Sube tu SavedVariables
        </h1>
        <p class={`${ui.text.bodyMuted} mt-3 max-w-lg mx-auto italic`}>
          Carga tu <code class="text-amber-300">RaidDominion.lua</code> para ver el roster, las bandas y los roles de tu hermandad.
        </p>
      </header>
      <div class={`${ui.dividerFadeBoth} mt-6 mb-10`} aria-hidden="true"></div>

      <!-- Dropzone -->
      <section class="bg-gray-900/50 backdrop-blur-sm border border-amber-600/30 rounded-md p-4 sm:p-6 md:p-8 mb-8">
        <label
          for="sv-file"
          id="dropzone"
          class="flex flex-col items-center justify-center border-2 border-dashed border-amber-600/40 rounded-md p-8 sm:p-10 cursor-pointer hover:border-amber-500/70 hover:bg-amber-900/10 ${ui.transition}"
        >
          <svg class="w-10 h-10 text-amber-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
          <span class="text-sm text-amber-200 font-medium">Arrastra tu archivo aquí o haz clic para seleccionarlo</span>
          <span class="text-xs text-gray-500 mt-1">RaidDominion.lua · máx. 2 MB · uno o varios archivos</span>
          <input id="sv-file" type="file" accept=".lua,.txt,text/plain" class="hidden" multiple />
        </label>

        <div id="status" class={`mt-4 text-center ${ui.loading.liveText}`} aria-live="polite"></div>

        <!-- Advertencias -->
        <div id="warnings" class="mt-4 space-y-2"></div>
      </section>

      <!-- Resultado -->
      <section id="result" class="hidden space-y-6">
        <!-- Claim de maestro (solo vía SV; sin formularios) -->
        <div id="claim-banner" class="hidden bg-gradient-to-r from-amber-900/40 to-amber-800/20 border border-amber-600/40 rounded-md p-4 sm:p-6">
          <h2 class={`${ui.text.h2} text-amber-300 mb-2`}>¡Eres candidato a maestro de hermandad!</h2>
          <p class={`${ui.text.body} mb-4`}>
            Tu SavedVariables fue generado por <strong id="claim-char" class="text-amber-200"></strong> con rango de liderazgo.
            Al guardar el análisis, el portal detecta tu maestría y te permite registrar tu hermandad
            <strong class="text-amber-200">automáticamente desde el propio archivo</strong> (sin formularios).
          </p>
          <p id="claim-status-note" class="hidden text-sm text-amber-200/80">
            Si tu rango no es de liderazgo, tu solicitud quedará en revisión para un moderador.
          </p>
          <p id="claim-msg" class="hidden mt-3 text-sm rounded-md px-4 py-2.5" role="status"></p>
        </div>

        <!-- Cifras del procesamiento -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-md p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-guilds">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Hermandades</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-md p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-characters">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Personajes</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-md p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-bands">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Bandas</p>
          </div>
          <div class="bg-gray-900/50 border border-amber-600/30 rounded-md p-4 text-center">
            <p class="text-3xl font-bold text-amber-300" id="stat-rules">0</p>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mt-1">Reglas</p>
          </div>
        </div>

        <!-- Enlace al dashboard: el detalle vive en Mi cuenta. Arranca
             deshabilitado y se habilita solo cuando el parseo + procesamiento
             termina por completo (persistIfLoggedIn) -->
        <div class="text-center">
          <a id="dash-link" href="/dashboard" aria-disabled="true"
             class={`${ui.btnBase} ${ui.btnPrimary} inline-block px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105 opacity-40 pointer-events-none select-none`}>Ir a Mi dashboard →</a>
        </div>
      </section>

      <!-- Error -->
      <section id="error" class={`hidden ${ui.status.error} rounded-md p-4 sm:p-6`}>
        <h2 class={`${ui.text.h2} text-red-300 mb-2`}>No se pudo procesar el archivo</h2>
        <p id="error-msg" class="text-sm text-red-200/80"></p>
      </section>
      <div class={`${ui.dividerFadeLeft} mt-12`} aria-hidden="true"></div>
    </div>
  </main>
</Layout>

<script>
  import { parseSavedVariables } from '@/lib/parser/savedVariables';
  import type { ParsedSavedVariables, GuildMember } from '@/types/parser';
  import { el } from '@/lib/ui/preview';
  import { supabase } from '@/lib/supabase';
  import { toast } from '@/lib/ui/toast';
  import {
    saveUpload,
    getMyProfile,
    saveMyGuildSnapshotsFromSV,
    upsertMyCharacter,
    saveRosterEvidence,
    tryPromoteMember,
    claimGuildFromSV,
    upsertBands,
    ensureMyCharacterSlugs,
    checkCharacterOwner,
  } from '@/lib/api';

  const fileInput = document.getElementById('sv-file') as HTMLInputElement;
  const dropzone = document.getElementById('dropzone') as HTMLElement;
  const statusEl = document.getElementById('status') as HTMLElement;
  const warningsEl = document.getElementById('warnings') as HTMLElement;
  const resultEl = document.getElementById('result') as HTMLElement;
  const errorEl = document.getElementById('error') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;

  function setStatus(msg: string): void {
    statusEl.textContent = msg;
  }

  function showError(msg: string, title?: string): void {
    errorEl.classList.remove('hidden');
    errorMsg.textContent = msg;
    resultEl.classList.add('hidden');
    toast.error(title ?? 'No se pudo procesar el archivo', msg);
  }

  function clearWarnings(): void {
    warningsEl.innerHTML = '';
  }

  // El enlace al dashboard NO se habilita hasta que el parseo y todo el
  // procesamiento (historial, personajes, evidencia, bandas, promoción,
  // reclamos, portales) termina. Con varios archivos se vuelve a deshabilitar
  // por cada tanda y se rehabilita solo al terminar TODA la cola.
  const dashLink = document.getElementById('dash-link') as HTMLAnchorElement | null;
  function disableDashboardLink(): void {
    if (!dashLink) return;
    dashLink.classList.add('opacity-40', 'pointer-events-none', 'select-none');
    dashLink.setAttribute('aria-disabled', 'true');
  }
  function enableDashboardLink(): void {
    if (!dashLink) return;
    dashLink.classList.remove('opacity-40', 'pointer-events-none', 'select-none');
    dashLink.removeAttribute('aria-disabled');
  }

  // ── Cola de procesamiento ─────────────────────────────────────────────────
  // Varios archivos pueden subirse a la vez (y uno detrás de otro). Cada uno
  // se procesa en SERIE: el siguiente espera a que el anterior haya guardado
  // en BD (historial, personajes, bandas…), así siempre encuentra los datos
  // de su antecesor y las bandas del mismo nombre se COMBINAN en vez de
  // duplicarse. Mientras haya trabajo, la subida y el enlace quedan
  // bloqueados: no se aceptan más archivos hasta terminar la cola.
  let processingChain: Promise<void> = Promise.resolve();
  let pendingCount = 0;

  function setUploadBusy(busy: boolean): void {
    fileInput.disabled = busy;
    dropzone.classList.toggle('pointer-events-none', busy);
    dropzone.classList.toggle('opacity-60', busy);
    dropzone.setAttribute('aria-disabled', String(busy));
  }

  function enqueueFiles(files: File[]): void {
    if (files.length === 0) return;
    // Bloqueo: si viene una cola en curso, las nuevas subidas se ignoran
    // (la espera garantiza que el sucesor encuentre los datos del antecesor).
    if (fileInput.disabled || pendingCount > 0) return;
    setUploadBusy(true);
    disableDashboardLink();
    pendingCount += files.length;
    processingChain = processingChain
      .then(() => files.reduce((p, f) => p.then(() => handleFile(f)), Promise.resolve()))
      .finally(() => {
        pendingCount = 0;
        setUploadBusy(false);
        enableDashboardLink();
      });
  }

  function addWarning(msg: string, opts?: { toast?: boolean }): void {
    warningsEl.appendChild(el('div', 'text-xs text-amber-200/80 bg-amber-900/20 border-l-2 border-amber-500/50 px-4 py-2 rounded-md', '⚠ ' + msg));
    if (opts?.toast === false) return;
    toast.warning('Atención', msg);
  }

  // Persiste el parseo si hay sesión activa; si no, invita a iniciar sesión
  async function persistIfLoggedIn(data: ParsedSavedVariables): Promise<void> {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session?.user) {
      const info = el('div', 'text-xs text-gray-400 bg-gray-900/60 border-l-2 border-amber-500/50 px-4 py-2 rounded-md mt-2');
      info.appendChild(document.createTextNode('Inicia sesión para guardar este análisis en tu historial. '));
      const link = el('a', 'text-amber-300 underline hover:text-amber-200', 'Iniciar Sesión');
      (link as HTMLAnchorElement).href = '/login?next=%2Fupload';
      info.appendChild(link);
      warningsEl.appendChild(info);
      enableDashboardLink();
      return;
    }

    // Pre-check (20260925, "a toda costa"): si el personaje PRINCIPAL del
    // archivo ya pertenece a OTRA cuenta, el SV es ajeno → NO se guarda nada
    // (ni historial, ni personajes, ni evidencia). Un SV ajeno no debe
    // persistir datos ni ensuciar el dashboard de esta cuenta.
    if (data.player?.name) {
      const ownerCheck = await checkCharacterOwner(data.player.name, data.player.realm ?? '');
      if (ownerCheck.ok && ownerCheck.result === 'other') {
        const msg = `El personaje principal (${data.player.name}) ya está registrado en otra cuenta. No se guardó ningún dato en tu historial.`;
        setStatus('Archivo de otra cuenta: no se guardó nada.');
        toast.warning('No se guardó', msg);
        addWarning(msg + ' Si es tuyo, contacta a un moderador para resolverlo.');
        enableDashboardLink();
        return;
      }
      if (!ownerCheck.ok) {
        addWarning('No se pudo verificar la propiedad del archivo: ' + (ownerCheck.error || '') + '. Contacta a soporte si persiste.');
      }
    }

    setStatus('Guardando en tu historial…');
    const saved = await saveUpload(data);
    if (!saved.ok) {
      const msg = 'Archivo procesado, pero no se pudo guardar en el historial: ' + (saved.error || 'error desconocido');
      setStatus(msg);
      toast.error('Historial no guardado', saved.error || 'Error desconocido');
      enableDashboardLink();
      return;
    }
    if (!saved.id) {
      const msg = 'Archivo procesado, pero el historial quedó incompleto. Vuelve a subir tu archivo.';
      setStatus(msg);
      toast.warning('Historial incompleto', 'Vuelve a subir tu SavedVariables.');
      enableDashboardLink();
      return;
    }

    // Registro por personaje usando SU snapshot del registry (equipo incluido).
    // REGLA (20260925): registry es la ÚNICA fuente de registro de personajes;
    // la tabla `characters` del archivo NO registra nada.
    let charStatus: string | null = null;
    const conflicts: string[] = [];

    for (const reg of data.registries) {
      if (!reg.player) continue;
      const up = await upsertMyCharacter(saved.id, reg.player, reg.savedAt, reg.guild);
      const isActiveReg = Boolean(data.player &&
        reg.player.name.toLowerCase() === data.player.name.toLowerCase() &&
        (reg.player.realm ?? '').toLowerCase() === (data.player.realm ?? '').toLowerCase());
      if (!up.ok || up.result === 'conflict') {
        conflicts.push(reg.player.name);
        if (!charStatus && (up.result === 'conflict' || isActiveReg)) charStatus = up.result === 'conflict' ? 'conflict' : null;
      } else if (isActiveReg || !charStatus) {
        charStatus = up.result ?? 'updated';
      }
    }
    const conflictNames = new Set(conflicts.map((c) => c.trim().toLowerCase()));
    if (conflicts.length > 0) {
      const msg = `No se registraron por pertenecer a otra cuenta: ${Array.from(new Set(conflicts)).join(', ')}. No se guardaron sus datos en tu cuenta. Contacta a un moderador si son tuyos.`;
      addWarning(msg);
      if (data.player && conflictNames.has(data.player.name.trim().toLowerCase())) charStatus = 'conflict';
    }
    if (data.player && !charStatus) charStatus = 'updated';

    // Evidencia de membresía en orden de fiabilidad (AGENTS.md §4):
    //   a) PRIMARIO: roster GM v3 (registry.*.guild.memberList) de todos los
    //      personajes del archivo — el addon no viaja con notas (privacidad).
    //   b) FALLBACK legacy: Guild.memberList (archivos antiguos v2).
    //   c) BANDAS: jugadores curados in-game por el líder.
    const evidenceRoster: GuildMember[] = [];
    const seenNames = new Set<string>();
    const pushEvidence = (m: GuildMember): void => {
      const key = m.name.trim().toLowerCase();
      if (!key || seenNames.has(key)) return;
      // Evidencia de personajes de OTRA cuenta: nunca se guarda a nombre de
      // esta cuenta (evita que un SV ajeno acredite membresía propia).
      if (conflictNames.has(key)) return;
      seenNames.add(key);
      evidenceRoster.push(m);
    };

    for (const reg of data.registries) {
      reg.guild?.memberList?.forEach((gm) => {
        pushEvidence({
          name: gm.name,
          class: gm.class ?? gm.classFile ?? '',
          rank: gm.rank || (typeof gm.rankIndex === 'number' ? String(gm.rankIndex) : ''),
          publicNote: '',
          officerNote: '',
        });
      });
    }
    data.guild.members.forEach(pushEvidence);
    data.bands.forEach((b) =>
      b.players.forEach((p) => {
        if (!p.name.trim()) return;
        pushEvidence({
          name: p.name.trim(),
          class: p.class ?? '',
          rank: 'banda',
          publicNote: '',
          officerNote: '',
        });
      })
    );
    if (evidenceRoster.length > 0) {
      await saveRosterEvidence(saved.id, evidenceRoster);
    }

    // Bandas + reglas → raiddominion_bands (personales o de hermandad, con
    // guild_id NULLABLE y visibilidad espejo). Re-subir el SV las actualiza.
    // Si el personaje PRINCIPAL del archivo pertenece a otra cuenta, el SV no
    // es tuyo: no se sincronizan sus bandas ni reglas a esta cuenta.
    const mainBlocked = Boolean(data.player && conflictNames.has(data.player.name.trim().toLowerCase()));
    if (mainBlocked) {
      addWarning('Bandas y reglas no sincronizadas: el personaje principal de este archivo pertenece a otra cuenta.');
    } else {
    setStatus('Sincronizando tus bandas y reglas…');
    const bandsSync = await upsertBands(
      saved.id, data.bands ?? [], data.rules ?? [],
      data.registryGuild?.rankIndex ?? null, data.registryGuild?.name ?? null,
      data.player?.name ?? null, data.player?.realm ?? null,
    );
    if (bandsSync.ok) {
      if (bandsSync.count && bandsSync.count > 0) {
        const msg = `${bandsSync.count} banda${bandsSync.count === 1 ? '' : 's'} sincronizada${bandsSync.count === 1 ? '' : 's'}.`;
        setStatus(msg);
        toast.success('Bandas sincronizadas', msg);
      }
    } else {
      const msg = 'No se pudieron sincronizar tus bandas: ' + (bandsSync.error || '') + '. Reintenta subiendo el SV de nuevo.';
      addWarning(msg);
    }
    }

    // Slug legible de personajes (name-reino): la migración v4 lo asigna en
    // el propio upsert; este RPC cubre filas previas y cambios de nombre/reino.
    const slugSync = await ensureMyCharacterSlugs();
    if (!slugSync.ok) {
      addWarning('No se pudieron asegurar los enlaces de tus personajes: ' + (slugSync.error || ''));
    }

    // Onboarding visitante → member.
    // Regla (20260830): una cuenta con DOS O MÁS personajes registrados en su
    // historial (sin importar si son de la misma hermandad o no) valida TODOS
    // sus personajes y pasa a 'member'. Regla GM (20260925): si el SV acredita
    // maestría (isGM), UN personaje registrado basta para validar la cuenta.
    // Los personajes que entren después heredan la validación (conteo
    // acumulado). Jamás degrada a quien ya es member/guild_master.
    let role: string | null = null;
    const profRes = await getMyProfile();
    role = profRes.ok ? profRes.profile?.role ?? null : null;

    if (charStatus !== 'conflict') {
      setStatus('Validando tu cuenta…');
      const promo = await tryPromoteMember(saved.id);
      if (promo.ok && promo.data?.promoted) {
        const wasVisitante = role === 'visitante';
        const msg = wasVisitante
          ? '¡Bienvenido, Miembro! Tu cuenta quedó validada. Con tu SV de maestro (isGM) podrás reclamar tu hermandad.'
          : 'Registro actualizado. Tu cuenta ya estaba validada como Miembro.';
        renderOnboardingBanner('success', msg);
        toast.success(wasVisitante ? '¡Cuenta validada como Miembro!' : 'Registro actualizado', msg);
        if (wasVisitante) role = 'member';
      } else if (promo.ok) {
        // Sin auto-validación: se queda Visitante, sin pedir validación externa
        if (role === 'visitante') {
          const msg = 'Registrado como Visitante. Para ser Miembro, registra al menos dos personajes en tu SavedVariables.';
          renderOnboardingBanner('visitor', msg);
          toast.info('Sigue como Visitante', msg);
        }
      } else {
        addWarning('No se pudo validar tu personaje: ' + (promo.error || 'error desconocido') + '. Contacta a soporte si persiste.');
      }
    }

    // Reclamo multi-GM desde el SV (idempotente): crea/verifica CADA hermandad
    // donde el addon acredite isGM (registry.guild.isGM), incluso varias.
    // Funciona para member validado y para guild_master en re-uploads.
    const isGmInSV = Boolean(data.registryGuild?.isGM) ||
      data.registries.some((r) => r.guild?.isGM === true);
    if (saved.id && isGmInSV && charStatus !== 'conflict') {
      setStatus('El addon te reporta como Maestro: reclamando hermandades desde el SV…');
      const claimRes = await claimGuildFromSV(saved.id);
      if (claimRes.ok) {
        role = 'guild_master';
        const msg = '¡Hermandad(es) reclamada(s) desde tu SavedVariables! Ya eres Maestro; revisa la pestaña Hermandad.';
        renderOnboardingBanner('success', msg);
        toast.success('Maestro de hermandad confirmado', msg, { duration: 6000 });
      } else if (claimRes.error?.includes('personaje validado')) {
        // El reclamo (20260925) exige al menos UN personaje validado: el SV
        // con isGM valida con un personaje.
        addWarning('Tu SV acredita maestría, pero el reclamo requiere al menos un personaje validado. Registra tu personaje y vuelve a subir tu SV.');
      } else if (claimRes.error?.includes('otra cuenta')) {
        // Guard (20260925): el personaje principal del SV pertenece a otra
        // cuenta → jamás se reclama su hermandad.
        addWarning('Este SavedVariables pertenece a otra cuenta; no puedes reclamar su hermandad desde aquí.');
      } else if (claimRes.error?.includes('Requiere ser Miembro')) {
        // La cuenta aún no está validada como Miembro: el reclamo se
        // completará cuando quede validada (un personaje registrado basta si
        // el SV acredita maestría).
        addWarning('Tu SV indica maestría de hermandad, pero el reclamo requiere estar validado como Miembro. Registra tu personaje y vuelve a subir tu SV.');
      } else {
        addWarning('No se pudo reclamar la hermandad desde el SV: ' + (claimRes.error || ''));
      }
    }

    // Portal: el re-upload actualiza el snapshot (roster/bandas/reglas) de
    // CADA hermandad propia presente en el SV, SOLO si el personaje activo es
    // maestro (registry.guild.isGM). Una subida de otro rango jamás lo pisa.
    if (role === 'guild_master' && data.registryGuild?.isGM === true) {
      setStatus('Actualizando tu(s) portal(es)…');
      const snap = await saveMyGuildSnapshotsFromSV(data);
      if (snap.ok) {
        if (snap.updated > 0) {
          const msg = `Archivo procesado y guardado. ${snap.updated} portal(es) de tu hermandad actualizado(s).`;
          setStatus(msg);
          toast.success('Portal(es) actualizado(s)', msg, { duration: 5500 });
        } else {
          const msg = 'Archivo procesado y guardado. El SV no coincide con tus hermandades registradas; usa el personaje maestro para actualizar el portal.';
          setStatus(msg);
          toast.info('Portal no actualizado', msg);
        }
      } else {
        const msg = 'Archivo procesado y guardado, pero no se pudo actualizar el portal: ' + (snap.error || '');
        setStatus(msg);
        toast.warning('Portal sin actualizar', snap.error || 'Error desconocido');
      }
      enableDashboardLink();
      return;
    }

    const doneMsg = 'Archivo procesado y guardado en tu historial.';
    setStatus(doneMsg);
    toast.success('SavedVariables procesado', doneMsg);
    enableDashboardLink();
  }

  function renderOnboardingBanner(kind: 'success' | 'visitor', msg: string): void {
    const cls = kind === 'success'
      ? 'text-emerald-200 bg-emerald-950/40 border-l-2 border-emerald-500/60'
      : 'text-amber-100 bg-amber-950/30 border-l-2 border-amber-500/60';
    const box = el('div', 'text-xs px-4 py-3 rounded-md mb-2 ' + cls);
    box.textContent = kind === 'success' ? '✓ ' + msg : '⬆ ' + msg;
    warningsEl.prepend(box);
  }

  function renderResult(data: ParsedSavedVariables): void {
    // Hermandades del registro (registryGuild + registries[*].guild), dedupe
    // por nombre: son las hermandades que aparecen en el SV.
    const guildNames = new Set<string>();
    if (data.registryGuild?.name) guildNames.add(data.registryGuild.name.trim().toLowerCase());
    data.registries.forEach((reg) => {
      if (reg.guild?.name) guildNames.add(reg.guild!.name.trim().toLowerCase());
    });
    (document.getElementById('stat-guilds') as HTMLElement).textContent = String(guildNames.size);
    // Personajes = los que trae registry (única fuente de registro: las
    // entradas de registry con ficha de jugador). La tabla `characters` del
    // archivo NO se cuenta ni se registra.
    const regCharCount = data.registries.filter((r) => r.player).length;
    (document.getElementById('stat-characters') as HTMLElement).textContent = String(regCharCount);
    (document.getElementById('stat-bands') as HTMLElement).textContent = String(data.bands.length);
    (document.getElementById('stat-rules') as HTMLElement).textContent = String(data.rules.length);

    // Claim de maestro (auto por SV; sin formularios manuales)
    const claimBanner = document.getElementById('claim-banner') as HTMLElement;
    const claimStatusNote = document.getElementById('claim-status-note') as HTMLElement;
    if (data.generatedBy) {
      claimBanner.classList.remove('hidden');
      (document.getElementById('claim-char') as HTMLElement).textContent = data.generatedBy;
      claimStatusNote.classList.toggle('hidden', data.guild.isLeaderRank);
    } else {
      claimBanner.classList.add('hidden');
    }

    errorEl.classList.add('hidden');
    resultEl.classList.remove('hidden');
  }

  // Procesa UN archivo hasta el final (parseo + persistencia en BD). Resuelve
  // cuando todo terminó, para que la cola garantice que el archivo siguiente
  // encuentra ya los datos de este.
  function handleFile(file: File): Promise<void> {
    clearWarnings();
    if (file.size > 2 * 1024 * 1024) {
      showError(`"${file.name}" supera el límite de 2 MB.`, 'Archivo demasiado grande');
      return Promise.resolve();
    }
    setStatus('Leyendo archivo…');
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = async () => {
        const text = String(reader.result || '');
        setStatus('Parseando RaidDominion.lua…');
        try {
          const result = parseSavedVariables(text);
          if (!result.ok) {
            showError(result.errors.join(' '));
            return;
          }
          if (result.warnings.length > 0) {
            toast.warning(`El SV tiene ${result.warnings.length} advertencia${result.warnings.length === 1 ? '' : 's'}`, 'Revisa el bloque superior de advertencias para más detalle.');
          }
          result.warnings.forEach((w) => addWarning(w, { toast: false }));
          renderResult(result.data as ParsedSavedVariables);
          await persistIfLoggedIn(result.data as ParsedSavedVariables);
        } catch (e) {
          const err = 'Error inesperado al parsear: ' + String(e);
          showError(err, 'Error inesperado');
        } finally {
          resolve();
        }
      };
      reader.onerror = () => {
        showError(`No se pudo leer "${file.name}".`, 'Lectura fallida');
        resolve();
      };
      reader.readAsText(file);
    });
  }

  fileInput.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    if (files.length === 0) return;
    enqueueFiles(files);
    // Permite volver a seleccionar el mismo archivo en una subida futura.
    fileInput.value = '';
  });

  ['dragover', 'drop'].forEach((evt) => {
    dropzone.addEventListener(evt, (e) => e.preventDefault());
  });
  dropzone.addEventListener('drop', (e) => {
    // Bloqueada durante una cola en curso (ver enqueueFiles).
    if (e.defaultPrevented || fileInput.disabled || pendingCount > 0) return;
    const files = Array.from((e as DragEvent).dataTransfer?.files ?? []);
    if (files.length > 0) enqueueFiles(files);
  });
</script>