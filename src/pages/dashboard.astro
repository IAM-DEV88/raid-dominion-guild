---
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/Navigation.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { ui } from "@/lib/ui/design";

const ctaVacio = `${ui.btnBase} ${ui.btnPrimary} px-6 py-3 text-sm`;
---

<Layout
  title="Mi Dashboard - RaidDominion"
  description="Tu addon en la comunidad RaidDominion: registro, bandas, hermandad y perfil."
>
  <Navigation currentPath="/dashboard" />
  <main class="relative py-16">
    <div class="max-w-6xl mx-auto">
      <Breadcrumb />

      <!-- Encabezado del espacio personal: mobile-first, alineado a la izquierda,
           compacto (avatar + identidad + acciones en una fila; badges debajo) -->
      <header class="mb-8 animate-fade-in-1">
        <div class="flex items-start gap-4">
          <div
            id="avatar"
            class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center text-black text-lg font-black shadow-lg shadow-amber-900/30 ring-2 ring-amber-500/30 select-none"
          >
            –
          </div>
          <div class="min-w-0 flex-1">
            <p class={`${ui.eyebrow} mb-1`}>Mi cuenta</p>
            <h1
              id="account-title"
              class={`${ui.text.h1} ${ui.gradientTitle} tracking-wide leading-tight truncate`}
            >
              Cuenta
            </h1>
            <p
              id="user-email"
              class={`${ui.text.caption} italic mt-0.5 truncate`}
            >
            </p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <a
              href="/upload"
              class={`inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border bg-amber-900/40 border-amber-500/40 text-amber-300 hover:bg-amber-800/50 hover:border-amber-400/70 ${ui.transition} ${ui.focusRing}`}
              title="Sube tu SavedVariables"
              aria-label="Sube tu SavedVariables"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                ></path></svg
              >
              <span class="hidden sm:inline">Subir SV</span>
            </a>
            <button
              type="button"
              id="config-btn"
              class={`inline-flex items-center justify-center w-9 h-9 rounded-md text-[10px] font-black uppercase tracking-widest border bg-gray-800/70 border-gray-600 text-gray-300 hover:text-amber-200 hover:border-amber-500/50 ${ui.transition} ${ui.focusRing}`}
              aria-label="Configuración de perfil, seguridad y zona de peligro"
              title="Configuración de perfil, seguridad y zona de peligro"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
              >
            </button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-1.5 mt-3">
          <span
            id="role-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-gray-800/70 border-gray-600 text-gray-300`}
            >…</span
          >
          <span
            id="validated-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-gray-800/70 border-gray-600 text-gray-400`}
            >…</span
          >
          <span
            id="public-badge"
            class={`${ui.badge} ${ui.badgeMd} bg-gray-800/70 border-gray-600 text-gray-400`}
            >…</span
          >
        </div>
        <div class={`${ui.dividerFadeBoth} mt-6`} aria-hidden="true"></div>
      </header>

      <!-- Pestañas (generadas desde src/lib/ui/tabs.ts = contrato único;
           navegación con ←/→/Home/End; activación automática al enfocar) -->
      <nav
        id="tab-bar"
        class="flex flex-nowrap items-center gap-1 rd-tabbar relative mb-6 animate-fade-in-1 overflow-x-auto justify-start [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        style="animation-delay: 0.15s"
        role="tablist"
        aria-label="Secciones del panel"
      >
      </nav>

      <!-- ── Resumen ─────────────────────────────────────────────────────── -->

      <!-- ── Mi Registro (config + historial + visor) ─────────────────────── -->
      <section
        id="panel-registro"
        role="tabpanel"
        aria-labelledby="tab-registro"
        class="hidden space-y-6"
      >
        <!-- Estado vacío -->
        <EmptyState
          id="registro-empty"
          hidden
          icon="upload"
          eyebrow="Registro del addon"
          title="Aún no subes ningún SavedVariables"
          gradient={false}
          message="Sube tu archivo RaidDominion.lua para ver aquí todo tu registro: personaje, hermandad y configuración del addon."
          cta={{ label: "Ir a Subir SavedVariables", href: "/upload" }}
          ctaCls="px-6 py-3 text-sm"
        >
          <div slot="body">
            <p class="text-sm text-gray-400 max-w-md mx-auto mb-6">
              Sube tu archivo <code class="text-amber-300"
                >RaidDominion.lua</code
              > para ver aquí todo tu registro: personaje, hermandad y configuración
              del addon.
            </p>
            <a href="/upload" class={ctaVacio}>Ir a Subir SavedVariables</a>
            <p
              id="registro-empty-note"
              class="hidden mt-4 text-xs text-red-300"
            >
            </p>
          </div>
        </EmptyState>

        <div id="registro-main" class="hidden space-y-6">
          <!-- Ventana: cabecera + visor contiguos (sin gap ni radio en la junta,
               esquina inferior cuadrada) -->
          <div>
            <div
              class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}
            >
              <div
                class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
              >
                <div class="min-w-0">
                  <p class={`${ui.eyebrow} mb-1`}>Registro del addon</p>
                  <h2
                    id="hdr-registro-title"
                    class="text-lg font-bold text-amber-200 flex items-center"
                  >
                    <span
                      class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                    ></span>
                    <span
                      id="hdr-registro-title-text"
                      class={`${ui.gradientTitle} font-black italic`}
                      >Registro</span
                    >
                  </h2>
                  <!-- Indicadores del análisis seleccionado (liberan el contenido
                     de repetir cifras y títulos) -->
                  <div
                    class="flex flex-wrap gap-2 mt-3"
                    aria-label="Indicadores del registro"
                  >
                    <span class="${ui.badgeStat}">
                      Personajes <strong
                        id="hdr-registro-chars"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class="${ui.badgeStat}">
                      Hermandades <strong
                        id="hdr-registro-guilds"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class="${ui.badgeStat}">
                      Bandas <strong
                        id="hdr-registro-bands"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                    <span class="${ui.badgeStat}">
                      Reglas <strong
                        id="hdr-registro-rules"
                        class={`${ui.statValue} text-sm`}>0</strong
                      >
                    </span>
                  </div>
                </div>

                <div id="sv-select-wrap" class="md:w-80 shrink-0">
                  <div
                    class="bg-gray-950/50 border border-amber-700/30 rounded-md p-3 space-y-2"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <label
                        for="sv-select"
                        class="block text-[11px] font-black uppercase tracking-widest text-gray-500"
                        >Registro</label
                      >
                      <span
                        id="sv-counter"
                        class="text-sm font-bold text-amber-300"
                        aria-live="polite"></span>
                    </div>
                    <div class="relative">
                      <select
                        id="sv-select"
                        class="w-full px-4 py-2.5 pr-10 rounded-md bg-gray-950/80 border border-amber-700/40 text-sm text-amber-100 focus:border-amber-500/70 focus:outline-none focus:ring-2 focus:ring-amber-500/20 appearance-none cursor-pointer"
                      ></select>
                      <span
                        class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-amber-500/70"
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path></svg
                        >
                      </span>
                    </div>
                    <button
                      type="button"
                      id="sv-delete-btn"
                      class="w-full mt-2 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-md text-[11px] font-black uppercase tracking-widest border border-red-800/50 text-red-300 hover:bg-red-950/40 hover:text-red-200 ${ui.transition} ${ui.focusRing}"
                    >
                      <svg
                        class="w-3.5 h-3.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        ></path></svg
                      >
                      Eliminar este análisis
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Banner de reclamo condicional: franja contigua a la ventana
               (sin radio ni márgenes) entre la cabecera y el visor -->
            <div
              id="claim-banner"
              class="hidden border border-amber-600/30 border-t-0 bg-gradient-to-br from-amber-950/40 to-gray-900/60 p-4 sm:p-6"
            >
              <h3
                class="text-base font-black uppercase tracking-widest text-amber-300 mb-1"
              >
                ¿Lideras una o más hermandades?
              </h3>
              <p class="text-sm text-gray-300 mb-4">
                Tu SavedVariables acredita rango de liderazgo. Reclámalas y
                obtén el portal web gratuito de cada guild (puedes ser maestro
                de varias):
              </p>
              <ol class="space-y-2 mb-5 text-sm text-gray-300 list-none">
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center"
                    >1</span
                  ><span
                    >Sube tu SavedVariables donde el addon te reporte como
                    Maestro (<code class="text-amber-300"
                      >registry.guild.isGM</code
                    >).</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center"
                    >2</span
                  ><span
                    >Reclama aquí tus hermandades: la ficha de cada una nace con
                    los datos exactos del juego.</span>
                </li>
                <li class="flex gap-3">
                  <span
                    class="shrink-0 w-6 h-6 rounded-full bg-amber-500/15 border border-amber-400/50 text-amber-200 text-xs font-black flex items-center justify-center"
                    >3</span
                  ><span
                    >Publícalas desde Hermandad y comparte <code
                      class="text-amber-300">/hermandad/tu-hermandad</code
                    >.</span>
                </li>
              </ol>
              <button
                type="button"
                id="claim-btn"
                class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest`}
                >Reclamar mis hermandades</button
              >
              <p
                id="claim-msg"
                class="hidden mt-3 text-sm rounded-md px-4 py-2.5"
                role="status"
              >
              </p>
            </div>

            <!-- Visor único del snapshot seleccionado: fondo sólido distintivo del
               cuerpo. El título y la fecha del análisis viven en el encabezado
               de la pestaña; aquí solo el contenido del registro. -->
            <div class={`${ui.sectionBody} space-y-5`}>
              <!-- Personajes del registro: fusión de registry.player + personajes
                 de la cuenta (characters) + registros por personaje (registries),
                 con la card de personaje estandarizada -->
              <div>
                <h4 class={ui.subTitle}>
                  Personajes del registro <span
                    id="cnt-viewer-chars"
                    class="text-gray-500"></span>
                </h4>
                <div
                  id="viewer-characters"
                  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mt-2"
                >
                </div>
              </div>

              <!-- Hermandades en el registro -->
              <div
                class="bg-gray-800/50 border border-amber-700/30 rounded-md p-4"
              >
                <h4 class={ui.subTitle}>Hermandades en el registro</h4>
                <div id="viewer-guilds" class="mt-2 space-y-2"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Mis Personajes ──────────────────────────────────────────────── -->
        <section
          id="panel-personajes"
          role="tabpanel"
          aria-labelledby="tab-personajes"
          class="hidden"
        >
          <!-- Estado vacío: sin personajes detectados -->
          <EmptyState
            id="characters-empty"
            hidden
            cls="mb-6"
            icon="user"
            eyebrow="Personajes"
            title="Aún no registras personajes"
            gradient={false}
            message="Sube tu SavedVariables desde el addon y aparecerán aquí."
            cta={{ label: "Subir ahora", href: "/upload" }}
            ctaCls="px-6 py-3 text-sm"
          />
          <div
            id="chars-sectionhead"
            class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}
          >
            <div
              class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
            >
              <div class="min-w-0">
                <p class={`${ui.eyebrow} mb-1`}>Personajes</p>
                <h2
                  id="hdr-chars-title"
                  class="text-lg font-bold text-amber-200 flex items-center"
                >
                  <span
                    class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                  ></span>
                  <span
                    id="hdr-chars-title-text"
                    class={`${ui.gradientTitle} font-black italic`}
                    >Mi roster de personajes</span
                  >
                </h2>
                <div
                  class="flex flex-wrap gap-2 mt-3"
                  aria-label="Indicadores de personajes"
                >
                  <span class="${ui.badgeStat}">
                    Personajes <strong
                      id="hdr-chars-total"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                  <span class="${ui.badgeStat}">
                    Públicos <strong
                      id="hdr-chars-public"
                      class={`${ui.statValue} text-sm`}>0</strong
                    >
                  </span>
                </div>
              </div>

              <!-- Ayuda al stat: detecta más personajes subiendo el SV -->
              <div class="md:w-80 shrink-0">
                <div
                  class="bg-gray-950/50 border border-amber-700/30 rounded-md p-3 space-y-2"
                >
                  <p
                    class="block text-[11px] font-black uppercase tracking-widest text-gray-500"
                  >
                    ¿Falta algún personaje?
                  </p>
                  <a
                    href="/upload"
                    class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-widest text-amber-300 hover:text-amber-200 transition-colors"
                  >
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                      ></path></svg
                    >
                    Subir SavedVariables
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div id="chars-sectionbody" class={`${ui.sectionBody} space-y-5`}>
            <!-- Datos del perfil: controles dentro del contenido de la ventana de
               personajes (nombre visible, principal, visibilidad pública, guardar).
               Estilo de sub-bloque del cuerpo, igual que los bloques del registro. -->
            <div
              class="bg-gray-800/50 border border-amber-700/30 rounded-md p-4"
            >
              <h4 class={ui.subTitle}>Datos del perfil</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="display-name" class={ui.form.label}
                    >Nombre visible</label
                  >
                  <input
                    type="text"
                    id="display-name"
                    maxlength="40"
                    placeholder="Tu nombre en el portal"
                    class={`${ui.form.input} ${ui.focusRing}`}
                  />
                </div>
                <div>
                  <label for="character-main" class={ui.form.label}
                    >Personaje principal</label
                  >
                  <div class="relative">
                    <select
                      id="character-main"
                      disabled
                      class={`${ui.form.input} ${ui.focusRing} appearance-none pl-3 pr-10 disabled:opacity-60 disabled:cursor-not-allowed`}
                    >
                      <option value="">Ninguno</option>
                    </select>
                    <svg
                      aria-hidden="true"
                      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-amber-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                    >
                  </div>
                  <p id="character-main-hint" class={ui.form.helperText}>
                    Solo puedes elegir entre los personajes detectados en tu
                    SavedVariables.
                  </p>
                </div>
              </div>

              <label
                for="profile-public"
                class={`mt-4 flex items-start gap-3 cursor-pointer select-none border border-gray-700/60 hover:border-amber-600/40 rounded-md p-4 ${ui.transition}`}
              >
                <input
                  type="checkbox"
                  id="profile-public"
                  class="mt-0.5 w-4 h-4 accent-amber-500"
                />
                <span class={`${ui.text.body} font-medium`}
                  >Perfil y datos públicos
                  <span class={`block ${ui.text.caption} italic mt-0.5`}
                    >Al activarlo, tu perfil de jugador será visible
                    públicamente para la comunidad.</span
                  >
                </span>
              </label>

              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button
                  id="save-profile"
                  class={`${ui.btnBase} ${ui.btnPrimary} px-6 py-2.5 text-xs font-black uppercase tracking-widest transform hover:scale-105 disabled:opacity-50 disabled:pointer-events-none`}
                >
                  Guardar cambios
                </button>
                <a
                  id="public-profile-link"
                  href="#"
                  target="_blank"
                  rel="noopener"
                  class={`hidden px-4 py-2 rounded-md text-xs font-black uppercase tracking-widest ${ui.status.success}`}
                  >Ver perfil público →</a
                >
              </div>
              <p
                id="profile-msg"
                class="hidden mt-3 text-sm rounded-md px-4 py-2.5"
                role="status"
              >
              </p>
            </div>

            <div
              id="characters-list"
              class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"
            >
            </div>
            <p
              id="characters-onboarding"
              class="hidden text-xs text-amber-100/90 bg-amber-950/30 border-l-2 border-amber-500/60 px-4 py-3 rounded-md"
            >
            </p>
            <p id="characters-status" class="hidden text-sm text-gray-400"></p>
          </div>
        </section>

        <!-- ── Mis Bandas ──────────────────────────────────────────────────── -->
        <section
          id="panel-bandas"
          role="tabpanel"
          aria-labelledby="tab-bandas"
          class="hidden"
        >
          <!-- Estado vacío: sin bandas registradas. Ventana propia, hermano del
             gestor (mismo modelo que Personajes/Hermandad/Registro). -->
          <EmptyState
            id="bands-empty"
            hidden
            cls="mb-6"
            icon="code"
            eyebrow="Bandas"
            title="Aún no detectamos bandas"
            gradient={false}
            message="Sube tu SavedVariables desde el addon para que tus bandas y reglas aparezcan aquí."
            cta={{ label: "Subir SavedVariables", href: "/upload" }}
            ctaCls="px-6 py-3 text-sm"
          />

          <div
            id="bands-sectionhead"
            class={`${ui.sectionHead} ${ui.cutTop} bg-gradient-to-br from-amber-900/20 to-transparent`}
          >
            <div
              class="md:flex md:items-start md:justify-between gap-6 space-y-6 md:space-y-0"
            >
              <div class="min-w-0">
                <p class={`${ui.eyebrow} mb-1`}>Gestión de bandas</p>
                <h2
                  id="hdr-band-name"
                  class="text-lg font-bold text-amber-200 flex items-center"
                >
                  <span
                    class="w-2 h-2 rounded-full bg-amber-500 mr-3 shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                  ></span>
                  <span
                    id="hdr-band-name-text"
                    class={`${ui.gradientTitle} font-black italic`}
                    >Mis bandas</span
                  >
                </h2>
                <!-- Indicadores de la banda seleccionada en el navegador (liberan
                   el detalle de repetir título y badges). Horario y GS viven en
                   el título, unidos como en el selector. -->
                <div
                  class="flex flex-wrap gap-2 mt-3"
